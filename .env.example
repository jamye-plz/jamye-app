# Copy this file to .env.local for daily local development.
# EXPO_PUBLIC_* values are embedded in the app bundle and are never secrets.
# Never place tokens, credentials, private endpoints, or user data in this file.
APP_VARIANT=development
EXPO_PUBLIC_APP_MODE=local-fixture
# Connected OAuth development only: EXPO_PUBLIC_APP_MODE=connected-auth
# EXPO_PUBLIC_API_ORIGIN=https://jamye-api.ridewithmin.com
# EXPO_PUBLIC_MEDIA_ORIGIN=https://jamye-media.ridewithmin.com
